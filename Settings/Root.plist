<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0"><dict><key>items</key><array>
    <dict>
        <key>cell</key><string>PSGroupCell</string>
        <key>label</key><string>CPU 低功耗</string>
        <key>footerText</key><string>独立于原 CPUthermal。关闭后保持系统原生温控；低功耗仅收紧 CPU 预算，不解除系统热保护。</string>
    </dict>
    <dict>
        <key>cell</key><string>PSSwitchCell</string>
        <key>key</key><string>enabled</string>
        <key>default</key><false/>
        <key>label</key><string>启用插件</string>
    </dict>
    <dict>
        <key>cell</key><string>PSSegmentCell</string>
        <key>key</key><string>powerMode</string>
        <key>default</key><string>fullPower</string>
        <key>label</key><string>常驻模式</string>
        <key>validTitles</key><array><string>原生</string><string>低功耗</string></array>
        <key>validValues</key><array><string>fullPower</string><string>lowPower</string></array>
    </dict>
    <dict>
        <key>cell</key><string>PSGroupCell</string>
        <key>footerText</key><string>省电：2.0W / 35%；标准：2.5W / 45%；性能：3.0W / 55%。熄屏时优先低功耗。</string>
    </dict>
    <dict>
        <key>cell</key><string>PSSegmentCell</string>
        <key>key</key><string>lowPowerStrength</string>
        <key>default</key><string>standard</string>
        <key>label</key><string>低功耗强度</string>
        <key>validTitles</key><array><string>省电</string><string>标准</string><string>性能</string></array>
        <key>validValues</key><array><string>saver</string><string>standard</string><string>performance</string></array>
    </dict>
    <dict>
        <key>cell</key><string>PSGroupCell</string>
        <key>label</key><string>应用名单</string>
        <key>footerText</key><string>原生表示回到 iOS 自身温控，不是解除温控。熄屏时两种名单都不会覆盖低功耗。</string>
    </dict>
    <dict>
        <key>cell</key><string>PSLinkCell</string>
        <key>label</key><string>低功耗模式的原生例外</string>
        <key>detail</key><string>CTFullPowerAppListController</string>
    </dict>
    <dict>
        <key>cell</key><string>PSLinkCell</string>
        <key>label</key><string>原生模式的低功耗应用</string>
        <key>detail</key><string>CTLowPowerAppListController</string>
    </dict>
</array></dict></plist>
